# Application Configuration
APP_NAME=Aerostake API
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL AsyncPG)
DATABASE_URL=postgresql+asyncpg://aerostake_user:aerostake_password@localhost:5432/aerostake_db
DB_ECHO=False

# Redis Configuration (In-Memory Cache & Sessions)
REDIS_URL=redis://localhost:6379/0

# Notification Services
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@latrics.com
FIREBASE_CREDENTIALS_PATH=

# JWT Authentication
JWT_SECRET_KEY=aerostake_dev_secret_key_change_in_production_9876543210
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
