# ==============================================================================
# AEROSTAKE BACKEND — PRODUCTION ENVIRONMENT TEMPLATE (.env.prod)
# Keep this file strictly on the VPS, permissions chmod 600, NEVER commit to git!
# ==============================================================================

# Application Configuration
APP_NAME=Aerostake API
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Isolated Production Postgres Container)
# Generate a strong password using: openssl rand -base64 24
POSTGRES_USER=aerostake_prod_user
POSTGRES_PASSWORD=replace_with_strong_production_password_here
POSTGRES_DB=aerostake_prod_db
DATABASE_URL=postgresql+asyncpg://aerostake_prod_user:replace_with_strong_production_password_here@postgres:5432/aerostake_prod_db
DB_ECHO=False

# Redis Configuration (Isolated Production Redis Container)
REDIS_URL=redis://redis:6379/0

# Transactional Email (Resend)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_live_your_actual_resend_api_key_here
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Push Notifications (Firebase Admin SDK)
# Place serviceAccountKey.json in /app/secrets/ on VPS and set absolute path:
FIREBASE_CREDENTIALS_PATH=/app/secrets/serviceAccountKey.json

# JWT Authentication
# Generate a 64-char random hex string using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_strong_64_char_random_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Set to your live frontend domains)
CORS_ORIGINS=["https://app.yourdomain.com", "https://api.yourdomain.com"]
