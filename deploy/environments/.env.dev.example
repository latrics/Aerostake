# ==============================================================================
# AEROSTAKE DEV / STAGING STACK ENVIRONMENT CONFIGURATION (.env.dev)
# Copy on VPS: cp deploy/environments/.env.dev.example .env.dev  (inside /srv/aerostake/dev)
# Permissions: chmod 600 .env.dev (DO NOT COMMIT TO GIT)
# ==============================================================================

# 1. Compose Stack Configuration
COMPOSE_PROJECT_NAME=aerostake-dev
ENVIRONMENT=staging
DEBUG=False
APP_NAME=Aerostake API (Dev)
APP_VERSION=0.1.0

# 2. Host Loopback Port Bindings (Collision-safe, avoids 8000/8001/8010/3000/3001)
API_PORT=18420
WEB_PORT=13420
HOST=0.0.0.0
PORT=8000

# 3. Live Domains & Routing
NEXT_PUBLIC_API_URL=https://dev.api-aerostake.latrics.com
FRONTEND_URL=https://dev.aerostake.latrics.com
CORS_ORIGINS=["https://dev.aerostake.latrics.com", "https://dev.api-aerostake.latrics.com"]

# 4. Isolated Dev Postgres Container (Distinct volume & credentials from prod)
POSTGRES_USER=aerostake_dev_user
POSTGRES_PASSWORD=replace_with_strong_dev_password_openssl_rand_hex_16
POSTGRES_DB=aerostake_dev_db
DATABASE_URL=postgresql+asyncpg://aerostake_dev_user:replace_with_strong_dev_password_openssl_rand_hex_16@postgres:5432/aerostake_dev_db
DB_ECHO=False

# 5. Isolated Dev Redis Container
REDIS_URL=redis://redis:6379/0

# 6. JWT Authentication
JWT_SECRET_KEY=replace_with_distinct_dev_64_char_key_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 7. Transactional Email & Push Notifications (Optional / Add your keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@aerostake.dev
FIREBASE_CREDENTIALS_PATH=
