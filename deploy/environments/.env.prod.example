# ==============================================================================
# AEROSTAKE PRODUCTION STACK ENVIRONMENT CONFIGURATION (.env.prod)
# Copy on VPS: cp deploy/environments/.env.prod.example .env.prod  (inside /srv/aerostake/prod)
# Permissions: chmod 600 .env.prod (DO NOT COMMIT TO GIT)
# ==============================================================================

# 1. Compose Stack Configuration
COMPOSE_PROJECT_NAME=aerostake-prod
ENVIRONMENT=production
DEBUG=False
APP_NAME=Aerostake API
APP_VERSION=0.1.0

# 2. Host Loopback Port Bindings (Collision-safe, avoids 8000/8001/8010/3000/3001)
API_PORT=18410
WEB_PORT=13410
HOST=0.0.0.0
PORT=8000

# 3. Live Domains & Routing
NEXT_PUBLIC_API_URL=https://api-aerostake.latrics.com
FRONTEND_URL=https://aerostake.latrics.com
CORS_ORIGINS=["https://aerostake.latrics.com", "https://api-aerostake.latrics.com"]

# 4. Isolated Production Postgres Container (Does NOT touch host 5432)
POSTGRES_USER=aerostake_prod_user
POSTGRES_PASSWORD=replace_with_strong_password_openssl_rand_hex_16
POSTGRES_DB=aerostake_prod_db
DATABASE_URL=postgresql+asyncpg://aerostake_prod_user:replace_with_strong_password_openssl_rand_hex_16@postgres:5432/aerostake_prod_db
DB_ECHO=False

# 5. Isolated Production Redis Container
REDIS_URL=redis://redis:6379/0

# 6. JWT Authentication
JWT_SECRET_KEY=replace_with_strong_64_char_key_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 7. Transactional Email & Push Notifications (Optional / Add your keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@aerostake.com
FIREBASE_CREDENTIALS_PATH=
